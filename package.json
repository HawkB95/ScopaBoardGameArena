 {
   "name": "projectbiagio",
   "version": "1.0.0",
   "description": "Scopa per Board Game Arena Studio",
   "main": "modules/js/Game.js",
   "scripts": {
     "build:ts": "rollup -c",
     "build:scss": "sass --no-source-map --style=compressed src/scss/Game.scss projectbiagio.css",
     "watch:ts": "rollup -c -w",
     "watch:scss": "sass --watch --style=compressed src/scss/Game.scss projectbiagio.css",
     "watch": "npm run watch:ts & npm run watch:scss",
     "build": "npm run build:ts && npm run build:scss"
   },
   "author": "Biagio Falco",
   "license": "MIT",
   "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.53.3",
    "sass": "^1.71.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
   }
 }